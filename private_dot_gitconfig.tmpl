{{- $codespaces := or (index . "codespaces") (eq (env "CODESPACES") "true") -}}
{{- /* Only enable 1Password SSH signing where its signer exists; Codespaces signs commits itself. */ -}}
{{- $opSshSign := "" -}}
{{- if not $codespaces -}}
{{-   range list "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" "/opt/1Password/op-ssh-sign" -}}
{{-     if and (not $opSshSign) (stat .) -}}
{{-       $opSshSign = . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ if not $codespaces }}[user]
{{ if $opSshSign }}	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINWFTLCIDBE3zhKz/6pQ7h8Mp3GGQtdXCni9Xm1ON6wG
{{ end }}	name = Michael Recachinas
	email = mrecachinas@github.com

{{ end }}[alias]
	br = branch --show-current
	brv = branch -av
	ci = commit
	co = checkout
	lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
	lg = !"git lg1"
	l = log --all --decorate --oneline --graph
	st = status --short
	tags = tag -l
	unstage = reset HEAD --
	staash = stash --all

[core]
	excludesfile = ~/.gitignore_global
	# fsmonitor = true
	# untrackedCache = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[commit]
{{ if $opSshSign }}	gpgsign = true
{{ end }}	verbose = true
[rerere]
	enabled = true
	autoupdate = true
[merge]
	# (just 'diff3' if git version < 2.3)
	conflictstyle = zdiff3
[pull]
	rebase = true
{{ if or (not $codespaces) (lookPath "git-lfs") }}[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
{{ end }}{{ if $opSshSign }}[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ $opSshSign }}
{{ end }}{{ if not $codespaces }}[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
{{ end }}[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
