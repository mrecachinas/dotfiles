{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

BREWFILE_CHECKSUM="{{ include "dot_Brewfile" | sha256sum }}"
BREWFILE="$HOME/.Brewfile"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
FULL_STATE="$STATE_DIR/brew-bundle.sha256"
NO_MAS_STATE="$STATE_DIR/brew-bundle-no-mas.sha256"
SKIP_MAS="${DOTFILES_SKIP_MAS:-0}"

case "$SKIP_MAS" in
    0|1) ;;
    *)
        echo "DOTFILES_SKIP_MAS must be 0 or 1" >&2
        exit 1
        ;;
esac

load_homebrew_shellenv() {
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    elif command -v brew >/dev/null 2>&1; then
        eval "$(brew shellenv)"
    fi
}

run_brew_bundle() {
    local brewfile="$1"
    HOMEBREW_BUNDLE_NO_UPGRADE=1 brew bundle --file="$brewfile" --no-upgrade
}

state_matches() {
    local state_file="$1"
    [[ -f "$state_file" ]] && [[ "$(cat "$state_file")" == "$BREWFILE_CHECKSUM" ]]
}

record_state() {
    local state_file="$1"
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$BREWFILE_CHECKSUM" >"$state_file"
}

load_homebrew_shellenv

if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew is required before running brew bundle" >&2
    exit 1
fi

if ! command -v mise >/dev/null 2>&1; then
    brew install mise
fi

echo "Installing mise-managed developer tools"
mise install
eval "$(mise env --shell bash)"

if [[ ! -f "$BREWFILE" ]]; then
    echo "$BREWFILE does not exist; skipping brew bundle" >&2
    exit 0
fi

if [[ "$SKIP_MAS" == 0 ]]; then
    echo "Installing Homebrew bundle"
    if ! run_brew_bundle "$BREWFILE"; then
        cat >&2 <<'EOF'
Homebrew bundle failed; completion was not recorded.
If Mac App Store apps failed, sign in to the App Store and rerun `chezmoi apply`.
To explicitly skip Mac App Store apps, run `DOTFILES_SKIP_MAS=1 chezmoi apply`.
EOF
        exit 1
    fi
    record_state "$FULL_STATE"
    exit 0
fi

echo "Mac App Store apps explicitly skipped (DOTFILES_SKIP_MAS=1)"
TEMP_BREWFILE="$(mktemp)"
trap 'rm -f "$TEMP_BREWFILE"' EXIT
awk '$1 != "mas" { print }' "$BREWFILE" >"$TEMP_BREWFILE"

if state_matches "$NO_MAS_STATE" && brew bundle check --file="$TEMP_BREWFILE" >/dev/null 2>&1; then
    cat <<'EOF'
Non-Mac App Store dependencies are already installed.
Sign in to the App Store, then rerun `chezmoi apply` without DOTFILES_SKIP_MAS to install Mac App Store apps.
EOF
    exit 0
fi

echo "Installing everything except Mac App Store apps"
if ! run_brew_bundle "$TEMP_BREWFILE"; then
    echo "Homebrew bundle failed; completion was not recorded." >&2
    exit 1
fi
record_state "$NO_MAS_STATE"

cat <<'EOF'
Mac App Store apps were skipped.
Sign in to the App Store, then rerun `chezmoi apply` without DOTFILES_SKIP_MAS to install them.
EOF
{{- end -}}
