#!/usr/bin/env zsh

# Uncomment below to begin profiling
# zmodload zsh/zprof

# ===== Personal Config =====
[ -f ~/.zsh_env ] && source ~/.zsh_env

# ===== Native Zsh Configuration =====
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000

setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt share_history

bindkey -e

autoload -Uz compinit
compinit -C

unsetopt menu_complete
unsetopt flowcontrol
setopt auto_menu
setopt complete_in_word
setopt always_to_end

zstyle ':completion:*' menu select
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' use-cache true

# Autosuggest settings
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

# Cache generated shell integrations until their executable or arguments change.
ZSH_INIT_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init"
[[ -d "$ZSH_INIT_CACHE_DIR" ]] || mkdir -p "$ZSH_INIT_CACHE_DIR"

_cache_zsh_init() {
    local command_name="$1"
    shift

    local executable="${commands[$command_name]:A}"
    local cache_key="${command_name}-${ZSH_VERSION}-${(j:-:)@}"
    cache_key="${cache_key//[^[:alnum:]_.-]/_}"

    local cache_file="$ZSH_INIT_CACHE_DIR/$cache_key.zsh"
    local temp_file="$cache_file.tmp.$$"

    if [[ ! -s "$cache_file" || "$executable" -nt "$cache_file" ]]; then
        command "$command_name" "$@" >| "$temp_file" || {
            rm -f "$temp_file"
            return 1
        }
        mv -f "$temp_file" "$cache_file"
    fi

    source "$cache_file"
}

# ===== Runtime Management =====
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

# ===== Tool Integrations =====
# Zoxide (smarter cd)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# Atuin (better shell history)
if command -v atuin >/dev/null 2>&1; then
    _cache_zsh_init atuin init zsh --disable-up-arrow
fi

# Direnv (per-directory environment)
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

# ===== Additional Integrations =====
[ -f ~/.config/op/plugins.sh ] && source ~/.config/op/plugins.sh

[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases

if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

if [[ -t 0 && -o zle ]] && command -v fzf >/dev/null 2>&1; then
    _cache_zsh_init fzf --zsh
fi

# ===== Starship Prompt (must be last) =====
if command -v starship >/dev/null 2>&1; then
    _cache_zsh_init starship init zsh
fi

unfunction _cache_zsh_init
unset ZSH_INIT_CACHE_DIR

# Uncomment below to begin profiling
# zprof
