#!/usr/bin/env zsh

# Uncomment below to begin profiling
# zmodload zsh/zprof

# ===== Oh-My-Zsh Configuration =====
export ZSH="$HOME/.oh-my-zsh"

# Disable theme - using Starship instead
ZSH_THEME=""

# Performance settings
zstyle ':omz:update' mode disabled
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_AUTO_UPDATE="true"
ZSH_DISABLE_COMPFIX="true"
DISABLE_COMPFIX="true"

# Lazy load nvm
zstyle ':omz:plugins:nvm' lazy yes

# Minimal plugin set
plugins=(
    git
    nvm
)

# Autosuggest settings
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# ===== Lazy-load rbenv =====
rbenv() {
    unfunction rbenv
    eval "$(command rbenv init -)"
    rbenv "$@"
}
# Ensure ruby/gem commands also trigger rbenv init
ruby() { rbenv version >/dev/null; unfunction ruby; ruby "$@"; }
gem() { rbenv version >/dev/null; unfunction gem; gem "$@"; }

# ===== Tool Integrations =====
# Zoxide (smarter cd)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# Atuin (better shell history)
if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# Direnv (per-directory environment)
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

# Broot (tree navigation)
[ -f ~/.config/broot/launcher/bash/br ] && source ~/.config/broot/launcher/bash/br

# ===== Lazy Sources =====
[ -s ~/.bun/_bun ] && source ~/.bun/_bun
[ -f ~/.cargo/env ] && source ~/.cargo/env
[ -f ~/.config/op/plugins.sh ] && source ~/.config/op/plugins.sh

# ===== Personal Config =====
[ -f ~/.zsh_env ] && source ~/.zsh_env
[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases

[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

export NVM_DIR="$HOME/.nvm"

if [[ -t 0 && -o zle ]] && command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi

# ===== Starship Prompt (must be last) =====
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Uncomment below to begin profiling
# zprof
